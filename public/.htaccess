# Orvalis — site estático na Hostinger (Apache/LiteSpeed). Ver docs/OPERATIONS.md e ADR 0013.
AddType application/manifest+json .webmanifest
AddType image/webp .webp

<IfModule mod_headers.c>
  # A página sempre confere se há versão nova (é ela que aponta para os arquivos novos).
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Arquivos com hash no nome (pasta assets/): mudam de nome a cada versão, então podem ficar em cache por 1 ano.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|webp|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
