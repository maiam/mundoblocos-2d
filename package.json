{
  "name": "mundoblocos-2d",
  "private": true,
  "version": "0.93.45",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:artifact": "VITE_WORLD=principal npm run build && node scripts/build-artifact.mjs",
    "bench": "vitest bench --run --config bench/vitest.config.ts",
    "build:artifact:santuario": "VITE_WORLD=santuario npm run build && node scripts/build-artifact.mjs santuario \"Santuário Celestial\"",
    "pack:site": "npm run build && rm -f orvalis-site.zip && cd dist && zip -qr ../orvalis-site.zip .",
    "build:net": "node scripts/build-net.mjs",
    "build:piloto3d": "VITE_PILOT_3D=1 npm run build -- --outDir dist-piloto",
    "preview:piloto3d": "vite preview --outDir dist-piloto --host",
    "parity:3d": "node scripts/parity-3d.cjs",
    "perf:cpu:3d": "node scripts/perf-cpu-3d.cjs"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.0",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
